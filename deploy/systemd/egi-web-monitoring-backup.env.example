# Install as /etc/egi-web-monitoring/backup.env with mode 0600.
BACKUP_S3_REQUIRED=true
BACKUP_S3_ENDPOINT=https://replace-with-offsite-s3-endpoint
BACKUP_S3_BUCKET=replace-with-private-backup-bucket
BACKUP_S3_PREFIX=egi-web-monitoring/postgresql
BACKUP_S3_REGION=us-east-1
BACKUP_S3_SSE=AES256
AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
