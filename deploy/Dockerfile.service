# CI must provide an immutable image reference containing @sha256:.
# Keep the default immutable as a safe fallback for direct local builds.
ARG BASE_IMAGE=node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
FROM ${BASE_IMAGE} AS build

WORKDIR /app
ARG BASE_IMAGE
RUN case "${BASE_IMAGE}" in node:*) \
      apt-get update \
      && apt-get upgrade -y \
      && apt-get install -y --no-install-recommends openssl ca-certificates \
      && rm -rf /var/lib/apt/lists/*; \
    ;; \
   esac
COPY . .

RUN npm ci --ignore-scripts
RUN npm run build -w @egi/database \
 && npm run build -w @egi/shared-types \
 && npm run build -w @egi/queue \
 && npm run build -w @egi/monitoring-rules \
 && npm run build -w @egi/logging

ARG SERVICE
ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build -w ${SERVICE}

FROM ${BASE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production
ARG BASE_IMAGE
RUN case "${BASE_IMAGE}" in node:*) \
      apt-get update \
      && apt-get upgrade -y \
      && apt-get install -y --no-install-recommends openssl ca-certificates \
      && rm -rf /var/lib/apt/lists/*; \
    ;; \
   esac
COPY --from=build /app /app

ARG SERVICE

# Keep application images production-only. Prisma Client remains a runtime
# dependency, while the CLI is installed from the locked, isolated toolchain
# only for the backend migration/seed profile.
RUN npm prune --omit=dev --ignore-scripts --no-audit --no-fund \
 && rm -rf /app/node_modules/prisma /app/node_modules/@prisma/config \
 && find /app/node_modules -type d -name deepmerge-ts -prune -exec rm -rf '{}' + \
 && node -e "require('/app/node_modules/@prisma/client')"

RUN if [ "${SERVICE}" = "@egi/backend" ]; then \
      install -d -m 755 /opt/egi-migration; \
      cp /app/deploy/migration-tools/package*.json /opt/egi-migration/; \
      npm ci --prefix /opt/egi-migration --omit=dev --ignore-scripts --no-audit --no-fund; \
      test "$(node -p "require('/opt/egi-migration/node_modules/deepmerge-ts/package.json').version")" = "8.0.1"; \
      /opt/egi-migration/node_modules/.bin/prisma --version; \
    fi

RUN npm_root="$(npm root -g)" \
 && rm -rf "${npm_root}/npm" \
 && rm -f "$(command -v npm)" "$(command -v npx)" \
 && if command -v corepack >/dev/null 2>&1; then rm -f "$(command -v corepack)"; fi

ENV EGI_SERVICE=${SERVICE}
CMD ["sh", "-c", "case \"$EGI_SERVICE\" in @egi/backend) exec node apps/backend/dist/main.js;; @egi/frontend) exec node node_modules/next/dist/bin/next start -p 3010;; @egi/scheduler) exec node apps/scheduler/dist/main.js;; @egi/worker) exec node apps/worker/dist/main.js;; *) echo \"Unknown service: $EGI_SERVICE\" >&2; exit 64;; esac"]
