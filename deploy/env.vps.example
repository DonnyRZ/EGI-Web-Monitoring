NODE_ENV=production

# Application images are built and published by CI. IMAGE_TAG must be the
# approved full commit SHA; do not use latest or a mutable release tag.
IMAGE_REGISTRY=ghcr.io/replace-with-owner/egi-web-monitoring
IMAGE_TAG=replace-with-approved-commit-sha
BACKEND_IMAGE_DIGEST=sha256:replace-with-verified-image-digest
FRONTEND_IMAGE_DIGEST=sha256:replace-with-verified-image-digest
SCHEDULER_IMAGE_DIGEST=sha256:replace-with-verified-image-digest
WORKER_IMAGE_DIGEST=sha256:replace-with-verified-image-digest
MIGRATION_IMAGE=node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
DEPLOY_APP_DIR=/var/www/egi-web-monitoring

# Pin infrastructure images to a verified immutable digest before copying
# this file to the VPS. The placeholders below are intentionally invalid.
REDIS_IMAGE=redis:7-alpine@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=egi_monitoring
DB_USER=egi_monitoring
DB_PASSWORD=replace-with-a-strong-unique-password
REDIS_PASSWORD=replace-with-a-strong-unique-password
REDIS_DB=0
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-a-strong-access-key
S3_SECRET_KEY=replace-with-a-strong-secret-key
S3_BUCKET=egi-monitoring
S3_PUBLIC_ENDPOINT=https://helloit.egiresources.com
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SEC=900
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=https://helloit.egiresources.com,https://internal.egiresources.com
# Used to build a link back to the app in notification emails (e.g. ticket assignment). Leave empty to omit the link.
PUBLIC_APP_URL=https://helloit.egiresources.com
ENABLE_SWAGGER=false
SCHEDULER_TICK_SECONDS=15
MONITORING_INTERVAL_MINUTES=5
HTTP_TIMEOUT_MS=15000
BROWSER_TIMEOUT_MS=45000
WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=3
LATE_JOB_SKIP_MS=240000
RETENTION_CRON=0 2 * * *
RETENTION_MONITORING_RESULTS_DAYS=90
RETENTION_SCREENSHOTS_DAYS=1
RETENTION_NOTIFICATIONS_DAYS=90

# SMTP — Gmail App Password for egi.egiholding@gmail.com (all outbound mail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=egi.egiholding@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM=EGI Monitoring <egi.egiholding@gmail.com>

# Explicit seed credentials. Keep blank in the normal production env file.
# The backend-seed Compose profile fails closed unless a reviewed password is
# supplied for that one invocation. Never add these values to CI logs.
SEED_ADMIN_PASSWORD=
