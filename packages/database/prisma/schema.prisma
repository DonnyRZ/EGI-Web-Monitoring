generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  end_user
  pic_web
  developer
  bos_it
  superadmin
}

enum MonitoringStatus {
  normal
  warning
  down
  unknown
}

enum Severity {
  critical
  high
  medium
  low
}

enum IncidentStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketCategory {
  website
  help_desk
  procurement
}

enum NotificationChannel {
  dashboard
  email
  telegram
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum TaskStatus {
  pending
  in_progress
  done
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(150)
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash")
  role             UserRole
  telegramChatId   String?   @map("telegram_chat_id") @db.VarChar(100)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions      UserSession[]
  ownedWebsites Website[]      @relation("WebsiteOwner")
  itWebsites Website[]          @relation("WebsiteItPic")
  backupItWebsites Website[]    @relation("WebsiteBackupItPic")
  assignedTickets Ticket[]     @relation("TicketAssignee")
  createdTickets Ticket[]      @relation("TicketCreator")
  assignedTasks Task[]         @relation("TaskAssignee")
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Website {
  id                         String   @id @default(uuid()) @db.Uuid
  name                       String   @db.VarChar(150)
  domain                     String   @db.VarChar(255)
  url                        String
  ownerId                    String?  @map("owner_id") @db.Uuid
  itPicId                    String?  @map("it_pic_id") @db.Uuid
  backupItPicId              String?  @map("backup_it_pic_id") @db.Uuid
  monitoringIntervalMinutes  Int      @default(5) @map("monitoring_interval_minutes")
  isActive                   Boolean  @default(true) @map("is_active")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  owner              User?              @relation("WebsiteOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  itPic              User?              @relation("WebsiteItPic", fields: [itPicId], references: [id], onDelete: SetNull)
  backupItPic        User?              @relation("WebsiteBackupItPic", fields: [backupItPicId], references: [id], onDelete: SetNull)
  monitoringResults  MonitoringResult[]
  incidents          Incident[]
  tasks              Task[]
  tickets            Ticket[]

  @@index([isActive])
  @@map("websites")
}

model MonitoringResult {
  id             String           @id @default(uuid()) @db.Uuid
  websiteId      String           @map("website_id") @db.Uuid
  scheduledAt    DateTime         @map("scheduled_at")
  checkedAt      DateTime         @map("checked_at")
  rawStatus      MonitoringStatus? @map("raw_status")
  status         MonitoringStatus
  httpOk         Boolean?         @map("http_ok")
  browserOk      Boolean?         @map("browser_ok")
  screenshotOk   Boolean?         @map("screenshot_ok")
  probeAborted   Boolean?         @map("probe_aborted")
  infrastructureFailure Boolean?  @map("infrastructure_failure")
  statusReason   String?          @map("status_reason")
  httpStatus     Int?             @map("http_status")
  responseTimeMs Int?             @map("response_time_ms")
  renderTimeMs   Int?             @map("render_time_ms")
  screenshotUrl  String?          @map("screenshot_url")
  errorMessage   String?          @map("error_message")
  createdAt      DateTime         @default(now()) @map("created_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, scheduledAt])
  @@index([websiteId])
  @@index([scheduledAt])
  @@index([websiteId, checkedAt])
  @@map("monitoring_results")
}

model Incident {
  id         String         @id @default(uuid()) @db.Uuid
  websiteId  String         @map("website_id") @db.Uuid
  title      String         @db.VarChar(255)
  severity   Severity
  status     IncidentStatus
  startedAt  DateTime       @map("started_at")
  resolvedAt DateTime?      @map("resolved_at")
  closedAt   DateTime?      @map("closed_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  notifications Notification[]

  @@index([websiteId])
  @@index([status])
  @@index([websiteId, status])
  @@index([startedAt])
  @@map("incidents")
}

model Ticket {
  id           String         @id @default(uuid()) @db.Uuid
  incidentId   String?        @map("incident_id") @db.Uuid
  websiteId    String?        @map("website_id") @db.Uuid
  createdBy    String?        @map("created_by") @db.Uuid
  title        String         @db.VarChar(255)
  category     TicketCategory?
  description  String?
  expectation  String?
  attachmentUrl String?       @map("attachment_url")
  assignedTo   String?        @map("assigned_to") @db.Uuid
  priority     Severity       @default(medium)
  status       TicketStatus
  slaDeadline  DateTime?      @map("sla_deadline")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  resolvedAt   DateTime?      @map("resolved_at")

  incident     Incident?      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  website      Website?       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  creator      User?          @relation("TicketCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignee     User?          @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  task         Task?

  @@index([incidentId])
  @@index([websiteId])
  @@index([createdBy])
  @@index([assignedTo])
  @@index([status])
  @@index([slaDeadline])
  @@map("tickets")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String?             @map("user_id") @db.Uuid
  incidentId   String?             @map("incident_id") @db.Uuid
  channel      NotificationChannel
  title        String              @db.VarChar(255)
  message      String
  status       NotificationStatus
  ccEmails     String[]            @default([]) @map("cc_emails")
  sentAt       DateTime?           @map("sent_at")
  readAt       DateTime?           @map("read_at")
  errorMessage String?             @map("error_message")
  createdAt    DateTime            @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([readAt])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model Task {
  id               String     @id @default(uuid()) @db.Uuid
  websiteId        String     @map("website_id") @db.Uuid
  assigneeId       String     @map("assignee_id") @db.Uuid
  ticketId         String?    @unique @map("ticket_id") @db.Uuid
  instructionNotes String     @map("instruction_notes")
  attachmentUrl    String?    @map("attachment_url")
  status           TaskStatus @default(pending)
  slaDeadline      DateTime?  @map("sla_deadline")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  website  Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  assignee User    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([assigneeId])
  @@index([status])
  @@index([slaDeadline])
  @@map("tasks")
}
