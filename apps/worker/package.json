{
  "name": "@egi/worker",
  "version": "0.1.0",
  "private": true,
  "description": "EGI Website Monitoring worker (HTTP health checks + notifications)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "tsx --test src/probes.test.ts src/target-safety.test.ts src/retention.test.ts",
    "test:notifications": "tsx --experimental-test-module-mocks --test src/notifications/email.test.ts src/notifications/dispatch.test.ts",
    "test:integration:rules": "tsx --test src/rules-apply.integration.test.ts",
    "test:integration:notifications": "tsx --test src/notifications/reconcile.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"@egi/worker: no lint configured yet\""
  },
  "dependencies": {
    "@egi/database": "*",
    "@egi/logging": "*",
    "@egi/monitoring-rules": "*",
    "@egi/queue": "*",
    "@egi/shared-types": "*",
    "bullmq": "^5.56.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.6.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
